# ---- Service ----
PORT=8080
LOG_LEVEL=info
# Shared secret required on the webhook (header x-webhook-secret or ?token=). Leave blank to disable.
WEBHOOK_SECRET=
TIMEZONE=America/Chicago
# Leave blank to derive "Spring YYYY" / "Fall YYYY" from the attempt date.
CURRENT_SEMESTER=
# park = log the attempt with no Student link. create = add the student to Airtable.
UNMATCHED_STUDENT_MODE=park
# Skip the write when the same Brillium GUID and attempt number is already on file.
SKIP_DUPLICATES=true

# ---- Brillium ----
BRILLIUM_API_BASE=https://yoursubdomain.brillium.com/api/v2
# Copy whichever auth the GHL custom_webhook actions used.
BRILLIUM_AUTH_HEADER=
BRILLIUM_API_KEY=
BRILLIUM_API_KEY_HEADER=X-API-KEY
BRILLIUM_USERNAME=
BRILLIUM_PASSWORD=
# {aid} and {guid} are substituted from the webhook payload.
BRILLIUM_ASSESSMENTS_PATH=/Assessments?AssessmentId={aid}
BRILLIUM_RESPONDENTS_PATH=/Respondents?RespondentGuid={guid}
# Which custom field carries each value. Brillium Field 3 holds the teacher name,
# Field 2 the school name, per the Airtable field notes.
BRILLIUM_TEACHER_NAME_FIELD=CUST3
BRILLIUM_SCHOOL_NAME_FIELD=CUST2
BRILLIUM_GRADE_LEVEL_FIELD=CUST4

# ---- Airtable ----
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appwFNJwQTtBif0yT
AIRTABLE_STUDENTS_TABLE=tblO81d82Ulhxz9np
AIRTABLE_TEACHERS_TABLE=tbl5eFPrtLsStLKQe
AIRTABLE_STUDENT_RECORDS_TABLE=tblNpWWDu0YSgiark
AIRTABLE_TYPECAST=true

# ---- Outbound notification ----
# Leave NOTIFY_WEBHOOK_URL blank and the service writes the row without notifying anyone.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_SIGNATURE_HEADER=x-forestryworks-signature
# always = send every result. matched = only when student and teacher both resolved.
NOTIFY_ON=always
