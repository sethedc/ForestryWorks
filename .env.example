# ---- Service ----
PORT=8080
LOG_LEVEL=info
# Shared secret required on the webhook (header x-webhook-secret or ?token=). Leave blank to disable.
WEBHOOK_SECRET=
# Replaces {{custom_values.current_semester}} from the GHL workflow.
CURRENT_SEMESTER=Fall 2026

# ---- Brillium ----
BRILLIUM_API_BASE=https://yoursubdomain.brillium.com/api/v2
# Copy whichever auth the GHL custom_webhook actions used.
BRILLIUM_AUTH_HEADER=
BRILLIUM_API_KEY=
BRILLIUM_API_KEY_HEADER=X-API-KEY
BRILLIUM_USERNAME=
BRILLIUM_PASSWORD=
# {aid} and {guid} are substituted from the webhook payload.
BRILLIUM_ASSESSMENTS_PATH=/Assessments?AssessmentId={aid}
BRILLIUM_RESPONDENTS_PATH=/Respondents?RespondentGuid={guid}

# ---- GoHighLevel ----
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Optional: skip the custom-field lookup by pinning the IDs.
GHL_FW_PROGRAM_FIELD_ID=
GHL_FW_PROGRAM_FIELD_NAME=FW Program
GHL_GRADE_LEVEL_FIELD_ID=
GHL_GRADE_LEVEL_FIELD_NAME=Grade Level
GHL_TEACHER_TAG=teacher
GHL_STUDENT_TAG=student

# ---- Airtable ----
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appwFNJwQTtBif0yT
AIRTABLE_STUDENTS_TABLE=tblO81d82Ulhxz9np
AIRTABLE_ATTEMPTS_TABLE=tblNpWWDu0YSgiark
AIRTABLE_TEACHERS_TABLE=Teachers
AIRTABLE_STUDENT_EMAIL_FIELD=Email
AIRTABLE_STUDENT_NAME_FIELD=Student Name
AIRTABLE_STUDENT_TEACHER_FIELD=Teacher
AIRTABLE_ATTEMPT_STUDENT_AS_LINK=false
AIRTABLE_TYPECAST=true

# ---- Email ----
# smtp sends real mail, console prints the message to the log instead.
EMAIL_TRANSPORT=smtp
MAIL_FROM=ForestryWorks <no-reply@forestryworks.com>
MAIL_REPLY_TO=
MAGGIE_EMAIL=mpope@forestryworks.com
TEACHER_EMAIL_BCC=mpope@forestryworks.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
